{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "src",
  "testRegex": ".*\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "collectCoverageFrom": ["elo/**/*.ts"],
  "coverageDirectory": "../coverage",
  "coverageThreshold": {
    "global": {
      "branches": 45,
      "functions": 55,
      "lines": 60,
      "statements": 60
    }
  },
  "testEnvironment": "node"
}
