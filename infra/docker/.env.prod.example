# Postgres / Redis
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this
POSTGRES_DB=adaptive_tutor

# API
PORT=3000
DATABASE_URL=postgresql://postgres:change_this@postgres:5432/adaptive_tutor?schema=public
JWT_SECRET=change_this_to_long_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REDIS_URL=redis://redis:6379
DEFAULT_TENANT_ID=public
CORS_ORIGIN=https://your-domain.com
AUTH_RATE_LIMIT_MAX=12
AUTH_RATE_LIMIT_TTL_MS=60000
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_REQUIRE_EMAIL_VERIFIED=true
AUTH_SESSION_BIND_USER_AGENT=true
AUTH_CAPTCHA_AFTER_FAILED_ATTEMPTS=3
AUTH_CAPTCHA_REQUIRED_MINUTES=30
AUTH_CAPTCHA_BYPASS_TOKEN=replace_with_real_captcha_verification_token_or_remove
AUTH_COOKIE_MODE=true
REFRESH_COOKIE_NAME=rt
REFRESH_COOKIE_MAX_AGE_MS=604800000
CSRF_COOKIE_NAME=csrf_token
COOKIE_SECURE=true
COOKIE_SAMESITE=none
COOKIE_SECRET=change_this_cookie_secret
TENANT_CACHE_TTL_MS=60000
AI_JOB_ATTEMPTS=3
AI_JOB_BACKOFF_MS=1000
AI_PROVIDER=stub
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_MS=15000
STUDENT_ELO_K=32
QUESTION_ELO_K=16
